# Copy this file to `.env` and fill in YOUR values. NEVER commit .env, never share
# your private key with anyone, never paste it into any chat or website.
#
# The signer private key (hex, 0x-prefixed). For a Polymarket account created with
# email/Magic or a browser wallet, this is the key you exported from the account.
POLY_PRIVATE_KEY=
#
# 0 = plain EOA wallet trades directly
# 1 = email/Magic-link Polymarket account (proxy wallet)
# 2 = browser-wallet Polymarket account (proxy wallet)
POLY_SIGNATURE_TYPE=
#
# The proxy/funder address shown in your Polymarket profile (required for types 1 and 2)
POLY_FUNDER=
#
# The final safety lock. Live orders are refused unless this is set, in your shell or
# here, to exactly: YES-LIVE   (and you still must type ARM at startup)
POLY_DRIFT_ARM=
